# ─────────────────────────────────────────────────────────────
# Ahli Bank AI Visibility Monitor — configuration
# Copy this file to .env.local and fill in what you have.
# With no engine keys the app runs in DEMO mode with simulated data.
# NEVER commit real keys to GitHub.
# ─────────────────────────────────────────────────────────────

# Force demo mode even if keys exist (true/false)
DEMO_MODE=

# ── AI engines (add any you have; missing ones are skipped) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# FREE: get a key at https://aistudio.google.com/apikey (no card needed).
# Free keys may not include Google Search; the app then answers from the model's knowledge.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# set to false to skip trying Google Search grounding
GEMINI_SEARCH=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Optional: any OpenAI-compatible endpoint (e.g. https://openrouter.ai/api/v1 with a DeepSeek model id)
DEEPSEEK_BASE_URL=

# Which engine reads and scores the answers: openai | anthropic | gemini | auto | none
# "none" = rule-based reading only (halves API calls; good for free plans)
ANALYZER_ENGINE=auto

# How many times to ask each question per engine (answers vary between runs)
REPEATS=3

# ── Database ──
# Local default: file:data/local.db
# Production (Vercel): a Turso database URL + token, e.g. libsql://xxx.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# ── Scheduling ──
# Secret used by the weekly scheduled run (Vercel Cron sends it automatically)
CRON_SECRET=
# Optional password that protects "Run now" and editing
ADMIN_TOKEN=

# ── "Ask the AI" page limits (protects your API budget on a public link) ──
ASK_PER_IP_PER_HOUR=10
ASK_DAILY_LIMIT=300
